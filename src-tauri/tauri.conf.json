{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alfred",
  "version": "0.5.0",
  "identifier": "org.goodguys.alfred",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Alfred — GoodGuys",
        "width": 460,
        "height": 800,
        "minWidth": 400,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5Q0NENzFFMkUxMjRDQTcKUldTblRCSXVIdGZNYVF1THdsNHYzdGkrWEZSUDdkeUU5WUR6OUltTnlURUthc3FZYkJ0bHJGQVUK",
      "endpoints": [
        "https://github.com/randy-girard/alfred-raid/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
